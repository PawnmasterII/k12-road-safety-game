  m_Name: Quiz_sh-school-bike
  m_EditorClassIdentifier: Assembly-CSharp:SafeStreets:QuizBank
  activityId: sh-school-bike
  title: School Zone + Bike Gear
  questions:
  - kind: 1
    prompt: Where should you cross the street near school?
    trueIsCorrect: 0
    choices:
    - At the crosswalk or crossing guard
    - Anywhere it is shorter
    - Between parked cars
    - Around the corner
    correctIndex: 0
    source: 'Guide, Grades 2-3: use a designated crossing; follow guard instructions'
  - kind: 1
    prompt: How should your bike helmet fit?
    trueIsCorrect: 0
    choices:
    - Level on your head with snug straps
    - Tilted back to look cool
    - Loose so it is comfy
    - Backwards
    correctIndex: 0
    source: 'Guide, Grades 4-5: helmet level, two finger-widths above eyebrows, straps
      form a V'
  - kind: 1
    prompt: You drop something near the school bus. What do you do?
    trueIsCorrect: 0
    choices:
    - Tell the bus driver
    - Quickly grab it
    - Ask a friend to get it
    - Come back for it later
    correctIndex: 0
    source: 'Guide, Grades 2-3: if an item falls near the bus, tell the driver instead
      of retrieving it'
  - kind: 0
    prompt: Wearing bright colors or reflectors helps drivers see me.
    trueIsCorrect: 1
    choices: []
    correctIndex: 0
    source: 'Guide, Grades 4-5: increase visibility in low light; visibility topic'
  - kind: 0
    prompt: When crossing, I only need to watch for fast cars.
    trueIsCorrect: 0
    choices: []
    correctIndex: 0
    source: 'Guide, Grades 2-3: look for turning vehicles, driveway traffic, backing
      vehicles'
