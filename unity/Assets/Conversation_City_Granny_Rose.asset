  m_Script: {fileID: 11500000, guid: 131e1dca5f7f2ca42be00771cea61f30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SafeStreets.Conversation
  speakerName: Granny Rose
  lines:
  - Oh, hello dear. I'm Rose - I need to get across to the grocery store.
  - My eyes aren't what they were. Hold on, will you walk over with me?
  - 'Parking lots are the worst part: cars back out and nobody looks for a little
    old lady.'
  closingTip: Stay on the stripes. And if a car has white backup lights on, we stop
    and wait.
