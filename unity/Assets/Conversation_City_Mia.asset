  m_Script: {fileID: 11500000, guid: 131e1dca5f7f2ca42be00771cea61f30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SafeStreets.Conversation
  speakerName: Mia
  lines:
  - Hey - I'm Mia. Library books are due today and I can't reach the crossing on
    my own.
  - The library is up this one-way street, so cars can come from a side you never
    expect.
  - Walk with me? I'll stay beside you the whole way.
  closingTip: Look both ways anyway - on a one-way street, cars can still come from
    either side.
