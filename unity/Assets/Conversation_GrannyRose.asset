  m_Script: {fileID: 11500000, guid: 131e1dca5f7f2ca42be00771cea61f30, type: 3}
  m_Name: Conversation_GrannyRose
  m_EditorClassIdentifier: Assembly-CSharp::SafeStreets.Conversation
  speakerName: Granny Rose
  lines:
  - My eyes aren't what they used to be, dear.
  - At night, wear something BRIGHT so drivers can see you!
  - //Granny Rose
  - "Helmets too \u2014 a helmet on your head is worth two in your backpack."
  closingTip: 'Be seen: bright clothes by day, reflectors at night.'
